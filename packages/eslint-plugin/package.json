{
  "name": "@swift-rust/eslint-plugin",
  "version": "0.2.1",
  "description": "ESLint rules for swift-rust projects.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "biome check --no-errors-on-unmatched $(pwd)/src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "eslint": "^8.57.0 || ^9.0.0"
  },
  "devDependencies": {
    "@types/eslint": "^8.56.0",
    "eslint": "^8.57.0",
    "typescript": "^6.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/multivrs-space/swift-rust.git",
    "directory": "packages/eslint-plugin"
  },
  "bugs": {
    "url": "https://github.com/multivrs-space/swift-rust/issues"
  },
  "homepage": "https://swift-rust.multivrs.space/"
}
