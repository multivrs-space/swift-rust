{
  "name": "@swift-rust/env",
  "version": "0.2.2",
  "description": "Loads .env files and exposes validated environment variables.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./load": {
      "types": "./dist/load.d.ts",
      "import": "./dist/load.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "biome check --no-errors-on-unmatched $(pwd)/src",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.38.0"
  },
  "devDependencies": {
    "typescript": "^6.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/multivrs-space/swift-rust.git",
    "directory": "packages/env"
  },
  "bugs": {
    "url": "https://github.com/multivrs-space/swift-rust/issues"
  },
  "homepage": "https://swift-rust.multivrs.space/"
}
