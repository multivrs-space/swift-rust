{
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": { "noUnusedVariables": "warn" },
      "style": { "useImportType": "warn", "useExportType": "warn" }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "files": {
    "includes": [
      "**/packages/**/*/src/**/*.ts",
      "**/packages/**/*/src/**/*.tsx",
      "**/packages/**/*/src/**",
      "**/scripts/src/**/*.ts",
      "**/test/**/*.ts",
      "**/docs/app/**/*.tsx",
      "**/examples/**/*/app/**/*.ts",
      "**/examples/**/*/app/**/*.tsx",
      "**/examples/**/*/components/**/*.ts",
      "**/examples/**/*/components/**/*.tsx",
      "**/examples/**/*/lib/**/*.ts",
      "**/apps/**/*/src/**/*.ts",
      "**/apps/**/*/src/**/*.tsx",
      "**/apps/**/*/app/**/*.ts",
      "**/apps/**/*/app/**/*.tsx",
      "!**/dist/**",
      "!**/node_modules/**",
      "!**/.turbo/**",
      "!**/.swift-rust/**",
      "!**/target/**",
      "!**/coverage/**",
      "!**/docs/app/docs/api-reference/components/image/page.tsx",
      "!**/docs/app/docs/api-reference/components/pdf/page.tsx",
      "!**/docs/app/docs/api-reference/components/video/page.tsx"
    ]
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" }
  },
  "json": { "formatter": { "indentWidth": 2, "trailingCommas": "none" } }
}
